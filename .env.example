# The backend base URL exposed to the client bundle.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# Kakao Developers > App settings > App keys > Native app key.
# Native app keys are embedded in mobile binaries; never put a REST API key or client secret here.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=

# Naver Developers > Application > App Settings
EXPO_PUBLIC_NAVER_CONSUMER_KEY=
EXPO_PUBLIC_NAVER_CONSUMER_SECRET=
EXPO_PUBLIC_NAVER_APP_NAME=함께가길
EXPO_PUBLIC_NAVER_SERVICE_URL_SCHEME=goto-naver

# NAVER Cloud Platform > Application Services > Maps > Application (Client ID).
# app.config.ts가 build-time에만 읽어서 네이티브 설정에 굽는 값이라 EXPO_PUBLIC_ 접두사가 없다.
# 등록된 애플리케이션의 iOS Bundle ID/Android 패키지명이 net.beyondimagination.gotoapp과
# 일치해야 지도가 뜬다 (안 맞으면 "잘못된 클라이언트 ID를 지정" 에러로 빈 격자만 보임).
NAVER_MAP_CLIENT_ID=

# Google Cloud Console > Credentials (OAuth 2.0 Client IDs)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Auth Mode: 'live' (default: real Kakao/Naver SDK & backend API) or 'mock' (in-memory mock adapter)
EXPO_PUBLIC_AUTH_MODE=live

# Persona for mock mode: NEW_SIGNUP_USER | WHEELCHAIR_USER | STROLLER_USER | SENIOR_VISUAL_USER | NICKNAME_CONFLICT_USER
EXPO_PUBLIC_DEV_PERSONA=NEW_SIGNUP_USER
