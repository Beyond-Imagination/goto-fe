# The backend base URL exposed to the client bundle.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080

# Kakao Developers > App settings > App keys > Native app key.
# Native app keys are embedded in mobile binaries; never put a REST API key or client secret here.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=

# Auth Mode: 'live' (default: real Kakao SDK & backend API) or 'mock' (in-memory mock adapter)
EXPO_PUBLIC_AUTH_MODE=live

# Persona for mock mode: NEW_SIGNUP_USER | WHEELCHAIR_USER | STROLLER_USER | SENIOR_VISUAL_USER | NICKNAME_CONFLICT_USER
EXPO_PUBLIC_DEV_PERSONA=NEW_SIGNUP_USER
