{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "app",
    "src",
    "tests",
    "global.d.ts",
    "env.d.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ]
}
